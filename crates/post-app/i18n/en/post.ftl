connect-server-label = Server
connect-name-label = Name
connect-button = Connect
connect-cancel-button = Cancel
connect-progress = Connecting to { $address }…
connect-note = This test version connects only to a server on this computer. The connection has no encryption.

problem-address-empty = Type the address of the server.
problem-address-invalid = The address must have the form host or host:port.
problem-address-port = The port must be a number from 1 to 65535.
problem-address-not-local = This version connects only to this computer. Use localhost.
problem-name-characters = A name can contain only a to z, 0 to 9, hyphen, and underscore.
problem-name-short = A name must have a minimum of 2 characters.
problem-name-long = A name can have a maximum of 20 characters.
problem-unreachable = No Post server answers at this address.
problem-closed = The connection to the server closed.
problem-protocol = The server sent data that Post does not understand.
problem-false-server = This server did not prove its identity. Post did not sign in.
problem-different-server = The server at this address is not the server that you know. Post did not sign in.
problem-missing-parts = This server needs functions that this version of Post does not have.
problem-name-required = Type a name for your new account.
problem-invitation-required = You have no account on this server. Paste an invite link to join.
problem-no-tls = This version connects only to a server on this computer.

error-unsupported-protocol = The server uses a different version of the protocol.
error-wrong-address = The server does not use this address.
error-account-exists = You already have an account on this server.
error-invalid-invitation = The invitation is not valid. Ask for a new invite link.
error-server = The server has a problem. Try again later.
error-invalid-name = The server refused the name.
error-name-taken = A different user has this name.
error-no-such-channel = The channel does not exist.
error-empty-text = A message must contain text.
error-text-too-long = A message can have a maximum of 4,000 characters.
error-other = The server refused the request.

chat-status = { $name } · connected
chat-leave-button = Leave
chat-input-placeholder = Message #{ $channel }
chat-joined = { $name } joined
chat-left = { $name } left
chat-not-sent = Post did not send the message. Try again.
