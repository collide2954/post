{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientMessage",
  "description": "A message from a client to the server.",
  "oneOf": [
    {
      "description": "Starts the sign-in. The server answers with a `challenge` message.",
      "type": "object",
      "properties": {
        "address": {
          "description": "The address that the client used for the connection, as `host:port`.",
          "type": "string"
        },
        "nonce": {
          "description": "A random value that the client makes for this connection.",
          "$ref": "#/$defs/Nonce"
        },
        "protocol": {
          "description": "The protocol version of the client.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "ref": {
          "description": "A number that the answer of the server repeats.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "supports": {
          "description": "The optional parts of the protocol that the client supports.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part"
          }
        },
        "type": {
          "type": "string",
          "const": "hello"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "address",
        "nonce",
        "supports"
      ]
    },
    {
      "description": "Signs in to an account that exists.",
      "type": "object",
      "properties": {
        "invitation": {
          "description": "The code of an owner link. It makes the account the server owner.",
          "anyOf": [
            {
              "$ref": "#/$defs/Code"
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "description": "The public key of the account.",
          "$ref": "#/$defs/Key"
        },
        "proof": {
          "description": "The signature of the account key for this connection.",
          "$ref": "#/$defs/Signature"
        },
        "ref": {
          "description": "A number that the answer of the server repeats.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "identify"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "key",
        "proof"
      ]
    },
    {
      "description": "Makes an account and signs in to it.",
      "type": "object",
      "properties": {
        "invitation": {
          "description": "The code of an invitation or of an owner link.",
          "$ref": "#/$defs/Code"
        },
        "key": {
          "description": "The public key of the new account.",
          "$ref": "#/$defs/Key"
        },
        "name": {
          "description": "The name that the user wants.",
          "type": "string"
        },
        "proof": {
          "description": "The signature of the account key for this connection.",
          "$ref": "#/$defs/Signature"
        },
        "ref": {
          "description": "A number that the answer of the server repeats.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "register"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "key",
        "proof",
        "name",
        "invitation"
      ]
    },
    {
      "description": "Sends a text to a channel.",
      "type": "object",
      "properties": {
        "channel": {
          "description": "The name of the channel, without the `#` sign.",
          "type": "string"
        },
        "ref": {
          "description": "A number that the answer of the server repeats.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "text": {
          "description": "The text of the message.",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "send"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "channel",
        "text"
      ]
    },
    {
      "description": "Makes an invitation. Only the server owner can make one.",
      "type": "object",
      "properties": {
        "lifetime": {
          "description": "The number of seconds until the invitation ends. Without this field, it has no end.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 1
        },
        "ref": {
          "description": "A number that the answer of the server repeats.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "invite"
        },
        "uses": {
          "description": "The number of accounts that the invitation can make. Without this field, it has no limit.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    {
      "description": "Asks for the open invitations of the server.",
      "type": "object",
      "properties": {
        "ref": {
          "description": "A number that the answer of the server repeats.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "invitations"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    {
      "description": "Cancels an invitation.",
      "type": "object",
      "properties": {
        "code": {
          "description": "The code of the invitation.",
          "$ref": "#/$defs/Code"
        },
        "ref": {
          "description": "A number that the answer of the server repeats.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "revoke"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "code"
      ]
    },
    {
      "description": "Changes the name of the account.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The new name.",
          "type": "string"
        },
        "ref": {
          "description": "A number that the answer of the server repeats.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "rename"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ]
    },
    {
      "description": "Makes a channel. The sender becomes its owner and its first member.",
      "type": "object",
      "properties": {
        "channel": {
          "description": "The name of the new channel, without the `#` sign.",
          "type": "string"
        },
        "kind": {
          "description": "The kind of the channel.",
          "$ref": "#/$defs/ChannelKind"
        },
        "ref": {
          "description": "A number that the answer of the server repeats.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "channel-create"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "channel",
        "kind"
      ]
    },
    {
      "description": "Joins a channel.",
      "type": "object",
      "properties": {
        "channel": {
          "description": "The name of the channel, without the `#` sign.",
          "type": "string"
        },
        "ref": {
          "description": "A number that the answer of the server repeats.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "join"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "channel"
      ]
    },
    {
      "description": "Leaves a channel.",
      "type": "object",
      "properties": {
        "channel": {
          "description": "The name of the channel, without the `#` sign.",
          "type": "string"
        },
        "ref": {
          "description": "A number that the answer of the server repeats.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "leave"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "channel"
      ]
    },
    {
      "description": "Asks for the channel list of the server.",
      "type": "object",
      "properties": {
        "ref": {
          "description": "A number that the answer of the server repeats.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "channels"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    {
      "description": "Changes the topic of a channel. Only the owner of the channel can change it.",
      "type": "object",
      "properties": {
        "channel": {
          "description": "The name of the channel, without the `#` sign.",
          "type": "string"
        },
        "ref": {
          "description": "A number that the answer of the server repeats.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "topic": {
          "description": "The new topic. An empty text removes the topic.",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "channel-topic"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "channel",
        "topic"
      ]
    },
    {
      "description": "Changes the name of a channel. Only the owner of the channel can change it.",
      "type": "object",
      "properties": {
        "channel": {
          "description": "The present name of the channel, without the `#` sign.",
          "type": "string"
        },
        "name": {
          "description": "The new name of the channel.",
          "type": "string"
        },
        "ref": {
          "description": "A number that the answer of the server repeats.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "channel-rename"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "channel",
        "name"
      ]
    },
    {
      "description": "Gives a channel to a different member of the channel. Only the owner can give it.",
      "type": "object",
      "properties": {
        "channel": {
          "description": "The name of the channel, without the `#` sign.",
          "type": "string"
        },
        "name": {
          "description": "The name of the member who becomes the owner.",
          "type": "string"
        },
        "ref": {
          "description": "A number that the answer of the server repeats.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "channel-give"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "channel",
        "name"
      ]
    },
    {
      "description": "Deletes a channel. Only the owner of the channel can delete it.",
      "type": "object",
      "properties": {
        "channel": {
          "description": "The name of the channel, without the `#` sign.",
          "type": "string"
        },
        "ref": {
          "description": "A number that the answer of the server repeats.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "channel-delete"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "channel"
      ]
    },
    {
      "description": "Invites a user to a private channel. Only the owner of the channel can invite a user.",
      "type": "object",
      "properties": {
        "channel": {
          "description": "The name of the channel, without the `#` sign.",
          "type": "string"
        },
        "name": {
          "description": "The name of the user.",
          "type": "string"
        },
        "ref": {
          "description": "A number that the answer of the server repeats.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "channel-invite"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "channel",
        "name"
      ]
    }
  ],
  "$defs": {
    "ChannelKind": {
      "description": "The kind of a channel.",
      "oneOf": [
        {
          "description": "Each member of the server can join the channel.",
          "type": "string",
          "const": "public"
        },
        {
          "description": "An invitation from the owner is necessary to join the channel.",
          "type": "string",
          "const": "private"
        }
      ]
    },
    "Code": {
      "description": "The code of an invitation: 12 letters and digits.",
      "type": "string",
      "pattern": "^[A-Za-z0-9]{12}$"
    },
    "Key": {
      "description": "A public key: 32 bytes as base64url text with no `=` characters.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "Nonce": {
      "description": "A random value: 32 bytes as base64url text with no `=` characters.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "Part": {
      "description": "The word for an optional part of the protocol: 2 to 20 lower-case letters and hyphens.",
      "type": "string",
      "pattern": "^[a-z]([a-z-]{0,18}[a-z])$"
    },
    "Signature": {
      "description": "A signature: 64 bytes as base64url text with no `=` characters.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
